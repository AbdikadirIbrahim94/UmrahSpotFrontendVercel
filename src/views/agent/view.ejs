<%- include('../partials/components/header.ejs'); %>
<%- include('../partials/components/top-bar.ejs'); %>
<%- include('../partials/components/sidebar.ejs'); %>

<style>
  /* Flat Admin Clean Theme - No Shadows / High Contrast */
  .main {
    padding: 20px;
  }

  .card {
    background-color: #ffffff;
    border: 1px solid #ced4da !important;
    border-radius: 4px !important;
    box-shadow: none !important;
    margin-bottom: 1.25rem;
  }

  .card-header {
    background-color: #f8f9fa;
    border-bottom: 1px solid #ced4da;
    padding: 0.75rem 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #212529;
  }

  .card-body {
    padding: 1rem;
  }

  /* Admin Data Table Grid */
  .admin-table-kv {
    width: 100%;
    margin-bottom: 0;
    font-size: 0.875rem;
  }

  .admin-table-kv td {
    padding: 0.5rem 0.25rem;
    border-bottom: 1px solid #e9ecef;
    vertical-align: middle;
  }

  .admin-table-kv tr:last-child td {
    border-bottom: none;
  }

  .admin-table-kv .kv-label {
    font-weight: 600;
    color: #495057;
    width: 40%;
  }

  .admin-table-kv .kv-value {
    text-align: right;
    color: #212529;
  }

  /* Tables inside cards */
  .table-admin-detail {
    font-size: 0.85rem;
    border: 1px solid #dee2e6;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .table-admin-detail th {
    background-color: #f1f3f5;
    color: #495057;
    font-weight: 600;
    border-bottom: 1px solid #dee2e6;
    padding: 0.4rem 0.5rem;
  }

  .table-admin-detail td {
    padding: 0.4rem 0.5rem;
    vertical-align: middle;
  }

  /* Status Header Control */
  .status-bar-admin {
    background-color: #f8f9fa;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .room-tag {
    display: inline-block;
    background: #e9ecef;
    border: 1px solid #ced4da;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.8rem;
    margin-right: 0.25rem;
    margin-bottom: 0.25rem;
  }
</style>

<main id="main" class="main">

  <!-- Breadcrumb Header -->
  <div class="pagetitle mb-3 d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h4 mb-1">Booking Details: <%= booking.groupName %></h1>
      <nav>
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
          <li class="breadcrumb-item"><a href="/portal/admin">Admin</a></li>
          <li class="breadcrumb-item"><a href="javascript:history.back()">Booking List</a></li>
          <li class="breadcrumb-item active">#<%= booking.id %></li>
        </ol>
      </nav>
    </div>
    <a href="/portal/agent/list" class="btn btn-sm btn-outline-secondary">
      &larr; Back to Booking List
    </a>
  </div>

  <section class="section">

    <!-- Status & Admin Action Bar -->
    <div class="status-bar-admin d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold">Current Status:</span>
        <% if (booking.status === 'confirmed' || booking.status === 'accepted') { %>
          <span class="badge bg-success">Accepted</span>
        <% } else if (booking.status === 'pending') { %>
          <span class="badge bg-warning text-dark">Pending</span>
        <% } else if (booking.status === 'rejected') { %>
          <span class="badge bg-danger">Rejected</span>
        <% } else { %>
          <span class="badge bg-info text-dark"><%= booking.status.replace('_', ' ') %></span>
        <% } %>
      </div>

      <form class="d-flex align-items-center gap-2 m-0" action="/agent/<%= booking.id %>/edit" method="POST">
        <label for="status" class="fw-bold small mb-0">Update Status:</label>
        <select name="status" id="status" class="form-select form-select-sm" style="width: auto;">
          <option value="pending" <%= booking.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="accepted" <%= booking.status === 'accepted' ? 'selected' : '' %>>Accepted</option>
          <option value="rejected" <%= booking.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          <option value="on_hold" <%= booking.status === 'on_hold' ? 'selected' : '' %>>On Hold</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Save</button>
      </form>
    </div>

    <!-- Layout Grid -->
    <div class="row">

      <!-- Left Column: Summary & Meta -->
      <div class="col-lg-4">
        
        <!-- Meta Details Card -->
        <div class="card">
          <div class="card-header">Booking Metadata</div>
          <div class="card-body">
            <table class="admin-table-kv">
              <tr>
                <td class="kv-label">Booking ID</td>
                <td class="kv-value fw-bold">#<%= booking.id %></td>
              </tr>
              <tr>
                <td class="kv-label">Agent ID</td>
                <td class="kv-value"><%= booking.agentId %></td>
              </tr>
              <tr>
                <td class="kv-label">Created Date</td>
                <td class="kv-value"><%= new Date(booking.created_at).toLocaleDateString() %></td>
              </tr>
            </table>
          </div>
        </div>

        <!-- Trip Overview Card -->
        <div class="card">
          <div class="card-header">Trip Overview</div>
          <div class="card-body">
            <table class="admin-table-kv">
              <tr>
                <td class="kv-label">Total Guests</td>
                <td class="kv-value fw-bold"><%= booking.totals.totalPax %> Guests</td>
              </tr>
              <tr>
                <td class="kv-label">Total Rooms</td>
                <td class="kv-value"><%= booking.totals.totalRooms %></td>
              </tr>
              <tr>
                <td class="kv-label">Total Nights</td>
                <td class="kv-value"><%= booking.totals.totalNights %></td>
              </tr>
              <tr>
                <td class="kv-label">Visa Service</td>
                <td class="kv-value text-capitalize"><%= booking.services.visa || 'N/A' %></td>
              </tr>
              <tr>
                <td class="kv-label">Transport</td>
                <td class="kv-value text-capitalize"><%= booking.services.transport || 'N/A' %></td>
              </tr>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-header">Agent Remarks & Notes</div>
          <div class="card-body">
            <div class="p-2 bg-light border rounded small">
              <% if (booking.notes && booking.notes.trim() !== '') { %>
                <%= booking.notes %>
              <% } else { %>
                <span class="text-muted fst-italic">No additional remarks provided.</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Itineraries & Notes -->
      <div class="col-lg-8">

        <!-- Makkah Itinerary -->
        <div class="card">
          <div class="card-header">Makkah Itinerary</div>
          <div class="card-body">
            <table class="admin-table-kv mb-3">
              <tr>
                <td class="kv-label">Hotel</td>
                <td class="kv-value">
                  <strong><%= booking.makkahHotelName || 'Not Selected' %></strong> 
                  <small class="text-muted d-block">ID: <%= booking.makkahHotelId || 'N/A' %></small>
                </td>
              </tr>
              <tr>
                <td class="kv-label">Stay Dates</td>
                <td class="kv-value">
                  <%= booking.dates.makkahIn %> &rarr; <%= booking.dates.makkahOut %>
                </td>
              </tr>
            </table>

            <div class="fw-bold small text-muted mb-1">Room Allocation:</div>
            <% if (booking.rooms.makkahOccupancy && booking.rooms.makkahOccupancy.length > 0) { %>
              <table class="table table-bordered table-admin-detail">
                <thead>
                  <tr>
                    <th style="width: 10%; text-align: center;">Qty</th>
                    <th>Room Type</th>
                    <th>Occupancy</th>
                    <th>Meal Plan</th>
                  </tr>
                </thead>
                <tbody>
                  <% booking.rooms.makkahOccupancy.forEach(function(room) { %>
                    <tr>
                      <td class="fw-bold text-center"><%= room.qty %></td>
                      <td><%= room.room_name %></td>
                      <td class="text-capitalize"><%= room.occupancy %></td>
                      <td><%= room.base_meal_plan || 'N/A' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else if (booking.rooms.makkah && Object.keys(booking.rooms.makkah).length > 0) { %>
              <% for (const [type, count] of Object.entries(booking.rooms.makkah)) { %>
                <span class="room-tag"><%= type %>: <strong><%= count %></strong></span>
              <% } %>
            <% } else { %>
              <span class="text-muted small">No rooms specified</span>
            <% } %>
          </div>
        </div>

        <!-- Madinah Itinerary -->
        <div class="card">
          <div class="card-header">Madinah Itinerary</div>
          <div class="card-body">
            <table class="admin-table-kv mb-3">
              <tr>
                <td class="kv-label">Hotel</td>
                <td class="kv-value">
                  <strong><%= booking.madinahHotelName || 'Not Selected' %></strong> 
                  <small class="text-muted d-block">ID: <%= booking.madinahHotelId || 'N/A' %></small>
                </td>
              </tr>
              <tr>
                <td class="kv-label">Stay Dates</td>
                <td class="kv-value">
                  <%= booking.dates.madinahIn %> &rarr; <%= booking.dates.madinahOut %>
                </td>
              </tr>
            </table>

            <div class="fw-bold small text-muted mb-1">Room Allocation:</div>
            <% if (booking.rooms.madinahOccupancy && booking.rooms.madinahOccupancy.length > 0) { %>
              <table class="table table-bordered table-admin-detail">
                <thead>
                  <tr>
                    <th style="width: 10%; text-align: center;">Qty</th>
                    <th>Room Type</th>
                    <th>Occupancy</th>
                    <th>Meal Plan</th>
                  </tr>
                </thead>
                <tbody>
                  <% booking.rooms.madinahOccupancy.forEach(function(room) { %>
                    <tr>
                      <td class="fw-bold text-center"><%= room.qty %></td>
                      <td><%= room.room_name || 'Standard' %></td>
                      <td class="text-capitalize"><%= room.occupancy %></td>
                      <td><%= room.base_meal_plan || 'N/A' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } else if (booking.rooms.madinah && Object.keys(booking.rooms.madinah).length > 0) { %>
              <% for (const [type, count] of Object.entries(booking.rooms.madinah)) { %>
                <span class="room-tag"><%= type %>: <strong><%= count %></strong></span>
              <% } %>
            <% } else { %>
              <span class="text-muted small">No rooms specified</span>
            <% } %>
          </div>
        </div>

        <!-- Agent Remarks -->
        

      </div>

    </div>
  </section>

</main>

<%- include('../partials/components/footer.ejs'); %>